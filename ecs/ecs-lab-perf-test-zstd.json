{
  "family": "ecs-lab-perf-test-zstd",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "3072",
  "ephemeralStorage": {
    "sizeInGiB": 30
  },
  "executionRoleArn": "arn:aws:iam::849279003559:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "ecs-lab-perf-test-zstd",
      "image": "PLACEHOLDER_REPLACED_BY_PIPELINE",
      "command": ["sleep", "infinity"],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-lab-perf-test-zstd",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
